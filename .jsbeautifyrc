{
  "html": {
    "indent_size": 2,
    "indent_char": " ",
    "max_preserve_newlines": 1,
    "preserve_newlines": true,
    "wrap_line_length": 0,
    "inline": ["i", "b", "strong", "em", "small", "code", "br"],
    "unformatted": ["code", "pre"],
    "content_unformatted": ["pre", "textarea"],
    "end_with_newline": true,
    "extra_liners": ["head", "body", "/html"]
  }
}
